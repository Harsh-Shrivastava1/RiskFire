# RiskFire Backend Environment Variables (Example)
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
AI_ENABLED=true
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30.0
GROQ_MAX_RETRIES=3

# MongoDB Configuration (Provide your real MongoDB URI in .env)
MONGODB_URI=mongodb://username:password@host/database?retryWrites=true&w=majority
MONGODB_DB_NAME=riskfire_db

# Simulation & Deterministic Defaults
DEFAULT_SIMULATION_SEED=49201
DEFAULT_SYNTHETIC_TRANSACTIONS=3200
DEFAULT_LOOKBACK_MINUTES=10

# Security & Audit Defaults
SYNTHETIC_SANDBOX_MODE=true
AUDIT_LOG_RETENTION_DAYS=90
DEV_MERCHANT_ID=m-dev-01
DEV_MERCHANT_NAME=Acme Payments India Pvt Ltd
