# ============================================================
# RiskFire — Environment Variables
# ============================================================
# Copy this file to .env and fill in all required values.
# NEVER commit .env to source control.
# ============================================================

# ============================================================
# AI Provider
# ============================================================

# Groq API key — https://console.groq.com
GROQ_API_KEY=

# AI provider selection: groq | openai | anthropic
AI_PROVIDER=groq

# Model to use (must be available on the selected provider)
AI_MODEL=openai/gpt-oss-120b

# ============================================================
# Database
# ============================================================

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://riskfire:riskfire_dev@localhost:5432/riskfire

# ============================================================
# Security
# ============================================================

# JWT signing secret — must be at least 32 characters
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# JWT expiry in seconds (default: 86400 = 24 hours)
JWT_EXPIRY_SECONDS=86400

# ============================================================
# Redis (Optional — for background simulation jobs)
# ============================================================

REDIS_URL=redis://localhost:6379/0

# ============================================================
# Application
# ============================================================

# Environment: development | staging | production
APP_ENV=development

# Backend host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Enable debug mode (development only)
DEBUG=true

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ============================================================
# Frontend (Vite)
# ============================================================

# Backend API URL (used by Vite at build time)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ============================================================
# Simulation Defaults
# ============================================================

# Default simulation seed when none is provided by user
# If empty, a random seed is generated per run
DEFAULT_SIMULATION_SEED=

# Maximum synthetic transaction count per simulation
MAX_SIMULATION_TRANSACTION_COUNT=50000

# Maximum simulation duration in hours
MAX_SIMULATION_DURATION_HOURS=720

# ============================================================
# IMPORTANT NOTES
# ============================================================
# - Never send real payment credentials to the AI provider
# - All simulation data is SYNTHETIC — no real PII or payment data
# - Financial exposure figures are SIMULATED ESTIMATES only
# ============================================================
